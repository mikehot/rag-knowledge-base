# Copy to .env (gitignored) for local or Docker runs. Never commit real secrets.

# Bind host for docker-compose published ports (default loopback only)
RAG_BIND_HOST=127.0.0.1

# Database
DB_URL=jdbc:postgresql://localhost:5432/rag_knowledge_base
DB_USERNAME=rag
DB_PASSWORD=change-me-db-password

# Auth (JWT_SECRET must be >= 32 bytes; leave APP_DEFAULT_PASSWORD empty in production)
JWT_SECRET=change-me-use-a-strong-random-64-byte-secret-in-production
APP_DEFAULT_USERNAME=demo
APP_DEFAULT_PASSWORD=

# Chat LLM (OpenAI-compatible)
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_API_KEY=
AI_MODEL_ID=google/gemma-4-26b-a4b-qat
AI_TEMPERATURE=0
AI_RESPONSE_FORMAT=json_schema
AI_REASONING_EFFORT=

# Embedding model (keep vector index and embedding model aligned)
AI_EMBEDDING_PROVIDER=openai-compatible
AI_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL_ID=text-embedding-bge-m3

# Ask-log retention (0 = retain indefinitely; set e.g. 30 or 90 in production)
ASK_LOG_RETENTION_DAYS=0
